<?xml version="1.0" encoding="utf-8"?>
<!-- Badman Recompiled for Android: tools and runtime only. The game library is
     built on the phone from the player's own ISO and never ships in the APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.psprecomp.badman"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- Preparing the game compiles it on the phone: a foreground task with a
         progress notification and a wake lock so a locked screen does not stall it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:label="Badman Recompiled"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:isGame="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- The Windows launcher's page in a WebView, laid out for portrait. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BuildService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Compiles the player's own game into a native library on the device" />
        </service>

        <!-- The game runs in its own process so quitting ends it completely. -->
        <activity
            android:name=".GameActivity"
            android:process=":game"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
